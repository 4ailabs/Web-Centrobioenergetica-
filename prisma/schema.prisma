// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String
  image         String?
  approved      Boolean   @default(false)
  isAdmin       Boolean   @default(false)

  // Sistema de XP y Premium (opcional para futuras funcionalidades)
  totalXP       Int       @default(0)
  premiumUnlocked Boolean @default(false)
  lastXPSync    DateTime?

  sessions      Session[]
  progress      Progress[]
  xpHistory     XPHistory[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Historial de XP ganado por app
model XPHistory {
  id        String   @id @default(cuid())
  userId    String
  appName   String   // ej: "detector-estados", "abrazo-mariposa"
  xpGained  Int
  details   String?  // ej: "Completó 5 rondas con 80% precisión"
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Progress {
  id            String   @id @default(cuid())
  userId        String
  courseId      Int?     // ID del curso
  sessionId     Int?     // ID de sesión (si aplica)
  moduleId      Int?     // ID del módulo
  videoId       Int?     // ID del video
  completed     Boolean  @default(false)
  progress      Int      @default(0) // Porcentaje de progreso (0-100)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, moduleId, videoId])
  @@index([userId, courseId])
}
