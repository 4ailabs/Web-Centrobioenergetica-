{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://*.framer.app https://*.framerusercontent.com https://www.institutocentrobioenergetica.com https://institutocentrobioenergetica.com" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/cuatro-caminos", "destination": "/cuatro-caminos/index.html" },
    { "source": "/regulacion-bioelectrica", "destination": "/regulacion-bioelectrica/index.html" },
    { "source": "/rb", "destination": "/rb/index.html" },
    { "source": "/crania", "destination": "/crania/index.html" },
    { "source": "/resonantia", "destination": "/resonantia/index.html" },
    { "source": "/reset-hormonal", "destination": "/reset-hormonal/index.html" },
    { "source": "/actos-que-mueven", "destination": "/actos-que-mueven/index.html" },
    { "source": "/taller-mascotas", "destination": "/taller-mascotas/index.html" },
    { "source": "/bioenergetica-transgeneracional", "destination": "/bioenergetica-transgeneracional/index.html" },
    { "source": "/cursos", "destination": "/cursos/index.html" },
    { "source": "/descubrir", "destination": "/descubrir/index.html" },
    { "source": "/servicios", "destination": "/servicios/index.html" },
    { "source": "/sobre-nosotros", "destination": "/sobre-nosotros/index.html" },
    { "source": "/calendario", "destination": "/calendario/index.html" },
    { "source": "/aplicaciones", "destination": "/aplicaciones/index.html" },
    { "source": "/aviso-de-privacidad", "destination": "/aviso-de-privacidad/index.html" },
    { "source": "/terminos-y-condiciones", "destination": "/terminos-y-condiciones/index.html" },
    { "source": "/test-hormonal", "destination": "/test-hormonal/index.html" },
    { "source": "/test-vinculo-animal", "destination": "/test-vinculo-animal/index.html" },
    { "source": "/((?!api|assets|images|favicon).*)", "destination": "/index.html" }
  ]
}
